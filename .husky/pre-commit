#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run lint-staged
npx lint-staged

# Full TypeScript type check runs on pre-push (see .husky/pre-push) to keep
# commits fast. CI also enforces it as the authoritative gate.

# Run tests related to changed files
echo "Running tests for changed files..."
npm run test:changed
